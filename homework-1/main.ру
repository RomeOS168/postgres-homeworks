import csv
import psycopg2

def main():
    conn = psycopg2.connect(
        host="localhost",
        database="north",
        user="postgres",
        password="Domik1608090"
    )
    
    try:
        with conn.cursor() as cur:
            
            with open('north_data/customers_data.csv', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    cur.execute(
                        "INSERT INTO customers VALUES (%s, %s, %s) ON CONFLICT DO NOTHING;",
                        (row['customer_id'], row['company_name'], row['contact_name'])
                    )
            
            with open('north_data/employees_data.csv', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    cur.execute(
                        "INSERT INTO employees VALUES (%s, %s, %s, %s, %s, %s) ON CONFLICT DO NOTHING;",
                        (int(row['employee_id']), row['first_name'], row['last_name'], row['title'], row['birth_date'], row['notes'])
                    )
            
            with open('north_data/orders_data.csv', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    cur.execute(
                        "INSERT INTO orders VALUES (%s, %s, %s, %s, %s) ON CONFLICT DO NOTHING;",
                        (int(row['order_id']), row['customer_id'], int(row['employee_id']), row['order_date'], row['ship_city'])
                    )
            
        conn.commit()
        print("Данные успешно загружены в базу данных!")
        
    except Exception as e:
        conn.rollback()
        print(f"Ошибка: {e}")
    finally:
        conn.close()

if __name__ == '__main__':
    main()
